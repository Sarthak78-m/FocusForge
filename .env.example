# FocusForge — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# For local development:
#   Copy to src/main/resources/application-local.properties
#   Run backend with: mvn spring-boot:run -Dspring-boot.run.profiles=local
#
# For Docker Compose:
#   cp .env.example .env && docker compose up -d

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=MindSprintDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_database_password

# Spring Boot datasource (used by backend service)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/MindSprintDB
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace_with_a_strong_database_password

# ── JWT Security ──────────────────────────────────────────────────────────────
# REQUIRED in production — generate a secure secret with:
#   openssl rand -base64 64
# Application will fail to start in production without this
JWT_SECRET=replace_with_a_base64_encoded_64_byte_secret
JWT_EXPIRATION=86400000   # Token lifetime in milliseconds (default: 24 hours)

# ── AI Features ───────────────────────────────────────────────────────────────
# At least one key is required for the AI coach chatbot to work.
# Without keys the chatbot returns a graceful degraded message.
#
# Gemini (recommended — faster, free tier available):
#   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI (fallback):
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_SMTP_AUTH=true
EMAIL_STARTTLS_ENABLED=true

# ── Authentication Security ───────────────────────────────────────────────────
# REQUIRED in production — must be true for production deployments
EMAIL_VERIFICATION_REQUIRED=true

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your frontend's origin in production.
# For local dev with Vite proxy this is not needed.
# For Vercel:  https://your-project.vercel.app  (or your custom domain)
FRONTEND_URL=http://localhost

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Required when deploying frontend to Vercel (or any static host).
# Points the React app to your deployed Spring Boot backend.
# For local dev: leave empty (Vite dev server proxy handles /api).
# Example:  https://focusforge-api.railway.app/api
VITE_API_BASE_URL=

# ── Spring Boot ───────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local
