# ── MindSprint Frontend — Production Environment ──────────────────────────────
#
# This file is loaded automatically by Vite during `vite build`.
# In Vercel, set these values in: Settings → Environment Variables
# (Vercel env vars take precedence over this file)
#
# IMPORTANT: All client-exposed env vars MUST be prefixed with VITE_

# Backend API base URL (REQUIRED for production)
# Point this to your deployed Spring Boot backend.
# Examples:
#   https://mindsprint-api.railway.app/api
#   https://api.mindsprint.com/api
VITE_API_BASE_URL=
