# ── FocusForge Frontend — Environment Variables ───────────────────────────────
#
# Copy this file to .env.local for local development.
# All client-exposed env vars MUST be prefixed with VITE_
#
# For Vercel deployment, set these in: Settings → Environment Variables

# Backend API base URL
# - Local dev:   leave empty (Vite proxy handles /api → localhost:8080)
# - Production:  set to your deployed backend URL, e.g. https://api.focusforge.com/api
VITE_API_BASE_URL=
